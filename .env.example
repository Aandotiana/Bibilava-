# ========================================================
# Bibilava / Neon Snake Environment Configuration
# ========================================================

# PORT: The port the Express/Socket.IO server listens on.
# Render automatically injects this at runtime (e.g., 10000).
# Locally defaults to 3000 if not specified.
PORT=3000

# NODE_ENV: Set to 'production' on Render Web Service.
NODE_ENV=production

# ALLOWED_ORIGIN: CORS allowed origin for Socket.IO.
# Defaults to '*' for open multi-origin access.
# On production, can be set to your Render URL (e.g., https://bibilava.onrender.com).
ALLOWED_ORIGIN=*

# VITE_SERVER_URL: Optional client-side URL to the Socket.IO server.
# Leave empty or omitted when serving frontend and backend from the same Render service (same-origin).
# Set only if frontend is deployed separately on a CDN or static site.
VITE_SERVER_URL=

# AI Studio injected variables (AI Studio preview environment):
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
